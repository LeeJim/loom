[Unit]
Description=loom SQLite Workflow Worker
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/loom/release-plan-approval
Environment=LOOM_WORKER_ISSUE=13
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/loom/release-plan-approval/worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/loom
UMask=0027

[Install]
WantedBy=multi-user.target
