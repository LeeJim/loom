[Unit]
Description=Loom development workflow console
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/loom/release-plan-approval/console
ExecStart=/usr/bin/python3 /opt/loom/release-plan-approval/console/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/loom/data
UMask=0077

[Install]
WantedBy=multi-user.target
