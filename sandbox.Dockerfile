FROM node:22-bookworm
ARG OPENCODE_VERSION=1.19.6
RUN test -n "$OPENCODE_VERSION" && npm install --global "opencode-ai@$OPENCODE_VERSION"
ENV HOME=/tmp OPENCODE_DISABLE_AUTOUPDATE=true OPENCODE_DISABLE_LSP_DOWNLOAD=true OPENCODE_DISABLE_EXTERNAL_SKILLS=true
USER node
WORKDIR /work
ENTRYPOINT ["opencode"]
