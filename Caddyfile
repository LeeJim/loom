{
	admin off
	auto_https disable_redirects
}

ai.anyhub.cn {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	@health {
		method GET HEAD
		path /healthz
	}
	handle @health {
		reverse_proxy 127.0.0.1:8787
	}

	@github {
		method POST
		path /webhooks/github
	}
	handle @github {
		reverse_proxy 127.0.0.1:8787
	}

	redir /console /console/ 308
	handle_path /console/* {
		basic_auth {
			import /etc/caddy/console-users.caddy
		}
		reverse_proxy 127.0.0.1:8790 {
			header_up -Authorization
		}
	}

	handle {
		respond 404
	}
}
